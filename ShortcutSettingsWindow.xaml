<ui:ThemedWindow x:Class="YeShunguangPet.ShortcutSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:YeShunguangPet"
    Title="快捷键" Width="580" Height="650" MinWidth="480" MinHeight="460"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="快捷键" Style="{StaticResource PageHeading}" Margin="0,0,0,20"/>
        <ui:SmoothScrollViewer x:Name="ShortcutScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ShortcutRows" Margin="0,0,8,0">
                <ItemsControl.ItemTemplate><DataTemplate>
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <CheckBox x:Name="EnabledCheck" Grid.Column="1" IsChecked="{Binding Enabled, Mode=TwoWay}" AutomationProperties.Name="{Binding Name}"
                                          Checked="Draft_Changed" Unchecked="Draft_Changed" ToolTip="启用快捷键"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,6" IsEnabled="{Binding IsChecked, ElementName=EnabledCheck}">
                                <TextBox x:Name="GestureBox" Width="190" Height="34" Padding="10,0" VerticalContentAlignment="Center"
                                         Text="{Binding GestureText, Mode=OneWay}" IsReadOnly="True" PreviewKeyDown="Gesture_KeyDown"
                                         ToolTip="点击后直接按下快捷键组合，例如 Alt+A" AutomationProperties.Name="快捷键输入框"/>
                                <Button x:Name="ClearGestureButton" Width="34" Height="34" Margin="8,0,0,0" Style="{StaticResource IconButton}"
                                        Content="&#xE711;" ToolTip="清除快捷键" AutomationProperties.Name="清除快捷键" Click="ClearGesture_Click"/>
                            </StackPanel>
                            <TextBlock Text="{Binding AppliedStatus}" Style="{StaticResource SecondaryLabel}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </ui:SmoothScrollViewer>
        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,10,0,12" TextWrapping="Wrap" MaxHeight="66" FontSize="12" AutomationProperties.LiveSetting="Polite"/>
        <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="DefaultsButton" HorizontalAlignment="Left" Click="Defaults_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE777;" Margin="0,0,8,0"/><TextBlock Text="恢复默认"/></StackPanel></Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="CancelButton" Content="取消" MinWidth="76" IsCancel="True" Margin="0,0,8,0"/>
                <Button x:Name="SaveButton" Content="保存" MinWidth="76" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:ThemedWindow>
