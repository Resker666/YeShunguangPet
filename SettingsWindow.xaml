<Window x:Class="YeShunguangPet.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="叶瞬光设置"
        Width="500"
        Height="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F7F7F7"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#A51F36" />
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,8,0,8" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,6,0,12" />
        </Style>
    </Window.Resources>

    <Grid Background="#F7F7F7" TextElement.Foreground="#202020">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Margin="16,16,16,8"
                    Background="Transparent"
                    BorderBrush="#D4D4D4">
            <TabItem Header="常规">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="角色大小" FontWeight="SemiBold" />
                            <TextBlock x:Name="ScaleValueText"
                                       DockPanel.Dock="Right"
                                       Foreground="#666666" />
                        </DockPanel>
                        <Slider x:Name="ScaleSlider"
                                Minimum="50"
                                Maximum="250"
                                TickFrequency="10"
                                IsSnapToTickEnabled="True" />

                        <Separator Margin="0,8,0,10" />

                        <CheckBox x:Name="TopmostCheckBox" Content="总在最前" />
                        <CheckBox x:Name="ClickThroughCheckBox" Content="点击穿透" />
                        <CheckBox x:Name="LaunchAtStartupCheckBox" Content="开机启动" />
                        <CheckBox x:Name="LookAtMouseCheckBox" Content="注视鼠标" />

                        <Separator Margin="0,10,0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="召回快捷键" FontWeight="SemiBold" />
                                <TextBlock x:Name="HotkeyStatusText"
                                           Margin="0,4,0,0"
                                           Foreground="#666666" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="立即召回"
                                    Click="Recall_Click" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="行为">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <CheckBox x:Name="RandomIdleCheckBox"
                                  Content="随机待机动作"
                                  FontWeight="SemiBold" />

                        <DockPanel LastChildFill="False"
                                   IsEnabled="{Binding IsChecked, ElementName=RandomIdleCheckBox}">
                            <TextBlock Text="触发间隔" />
                            <TextBlock x:Name="IdleIntervalValueText"
                                       DockPanel.Dock="Right"
                                       Foreground="#666666" />
                        </DockPanel>
                        <Slider x:Name="IdleIntervalSlider"
                                Minimum="15"
                                Maximum="120"
                                TickFrequency="5"
                                IsSnapToTickEnabled="True"
                                IsEnabled="{Binding IsChecked, ElementName=RandomIdleCheckBox}" />

                        <Separator Margin="0,10,0,10" />

                        <CheckBox x:Name="DesktopRoamingCheckBox"
                                  Content="桌面走动"
                                  FontWeight="SemiBold" />

                        <DockPanel LastChildFill="False"
                                   IsEnabled="{Binding IsChecked, ElementName=DesktopRoamingCheckBox}">
                            <TextBlock Text="走动间隔" />
                            <TextBlock x:Name="RoamIntervalValueText"
                                       DockPanel.Dock="Right"
                                       Foreground="#666666" />
                        </DockPanel>
                        <Slider x:Name="RoamIntervalSlider"
                                Minimum="20"
                                Maximum="180"
                                TickFrequency="5"
                                IsSnapToTickEnabled="True"
                                IsEnabled="{Binding IsChecked, ElementName=DesktopRoamingCheckBox}" />

                        <DockPanel LastChildFill="False"
                                   IsEnabled="{Binding IsChecked, ElementName=DesktopRoamingCheckBox}">
                            <TextBlock Text="走动速度" />
                            <TextBlock x:Name="RoamSpeedValueText"
                                       DockPanel.Dock="Right"
                                       Foreground="#666666" />
                        </DockPanel>
                        <Slider x:Name="RoamSpeedSlider"
                                Minimum="20"
                                Maximum="160"
                                TickFrequency="10"
                                IsSnapToTickEnabled="True"
                                IsEnabled="{Binding IsChecked, ElementName=DesktopRoamingCheckBox}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="关于">
                <StackPanel Margin="24" HorizontalAlignment="Center">
                    <Image Width="80"
                           Height="88"
                           Margin="0,10,0,12"
                           Stretch="Uniform"
                           Source="pack://application:,,,/YeShunguangPet;component/docs/idle-preview.png" />
                    <TextBlock Text="叶瞬光桌面宠物"
                               FontSize="20"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="VersionText"
                               Margin="0,6,0,18"
                               Foreground="#666666"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="来自云岿山、灵动自信的 Q 版剑客助手"
                               HorizontalAlignment="Center" />
                    <StackPanel Margin="0,24,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="项目主页" Click="OpenRepository_Click" />
                        <Button Content="日志目录" Click="OpenLogs_Click" />
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1"
                BorderBrush="#D4D4D4"
                BorderThickness="0,1,0,0"
                Background="#F0F0F0"
                Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" IsCancel="True" />
                <Button Content="保存"
                        IsDefault="True"
                        Foreground="White"
                        Background="{StaticResource AccentBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        Click="Save_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
