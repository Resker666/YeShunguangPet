<Window x:Class="YeShunguangPet.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面宠物设置"
        Width="500"
        Height="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F7F7F7"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#A51F36" />
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,8,0,8" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,6,0,12" />
        </Style>
    </Window.Resources>

    <Grid Background="#F7F7F7" TextElement.Foreground="#202020">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="SettingsTabs" Margin="16,16,16,8"
                    Background="Transparent"
                    BorderBrush="#D4D4D4">
            <TabItem x:Name="SkinTab" Header="皮肤">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ComboBox x:Name="PetSelector" MinHeight="30"
                              SelectedValuePath="Id" HorizontalContentAlignment="Stretch"
                              SelectionChanged="PetSelector_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" MaxWidth="360" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="MaxWidth" Value="400" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Image x:Name="SkinPreview" MaxWidth="192" MaxHeight="208" Stretch="Uniform" />
                        <TextBlock Grid.Row="1" x:Name="SkinDescription" Margin="0,8,0,0" TextWrapping="Wrap"
                                   MaxHeight="48" TextTrimming="CharacterEllipsis" Foreground="#555555" />
                        <TextBlock Grid.Row="2" x:Name="SkinDetails" Margin="0,4,0,0" Foreground="#666666" />
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="PreviewActionSelector" MinHeight="30" DisplayMemberPath="Name"
                                  SelectionChanged="PreviewAction_SelectionChanged" />
                        <Button Grid.Column="1" Width="36" Padding="0" ToolTip="重播动作" Click="Replay_Click">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;" />
                        </Button>
                    </Grid>
                    <StackPanel Grid.Row="3">
                        <ScrollViewer MaxHeight="64" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="SkinStatus" TextWrapping="Wrap" Foreground="#A51F36" />
                        </ScrollViewer>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="导入皮肤..." Click="ImportPet_Click" />
                            <Button Content="刷新" Click="RefreshPets_Click" />
                            <Button Content="皮肤目录" Click="OpenPets_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="常规">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="角色大小" FontWeight="SemiBold" />
                            <TextBlock x:Name="ScaleValueText"
                                       DockPanel.Dock="Right"
                                       Foreground="#666666" />
                        </DockPanel>
                        <Slider x:Name="ScaleSlider"
                                Minimum="50"
                                Maximum="250"
                                TickFrequency="10"
                                IsSnapToTickEnabled="True" />

                        <Separator Margin="0,8,0,10" />

                        <CheckBox x:Name="TopmostCheckBox" Content="总在最前" />
                        <CheckBox x:Name="ClickThroughCheckBox" Content="点击穿透" />
                        <CheckBox x:Name="EdgeAutoHideCheckBox" Content="贴边自动隐藏（四边）" />
                        <CheckBox x:Name="LaunchAtStartupCheckBox" Content="开机启动" />
                        <CheckBox x:Name="LookAtMouseCheckBox" Content="注视鼠标" />

                        <Separator Margin="0,10,0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="召回快捷键" FontWeight="SemiBold" />
                                <TextBlock x:Name="HotkeyStatusText"
                                           Margin="0,4,0,0"
                                           Foreground="#666666" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="立即召回"
                                    Click="Recall_Click" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="行为">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <CheckBox x:Name="RandomIdleCheckBox"
                                  Content="随机待机动作"
                                  FontWeight="SemiBold" />

                        <DockPanel LastChildFill="False"
                                   IsEnabled="{Binding IsChecked, ElementName=RandomIdleCheckBox}">
                            <TextBlock Text="触发间隔" />
                            <TextBlock x:Name="IdleIntervalValueText"
                                       DockPanel.Dock="Right"
                                       Foreground="#666666" />
                        </DockPanel>
                        <Slider x:Name="IdleIntervalSlider"
                                Minimum="15"
                                Maximum="120"
                                TickFrequency="5"
                                IsSnapToTickEnabled="True"
                                IsEnabled="{Binding IsChecked, ElementName=RandomIdleCheckBox}" />

                        <Separator Margin="0,10,0,10" />

                        <CheckBox x:Name="DesktopRoamingCheckBox"
                                  Content="桌面走动"
                                  FontWeight="SemiBold" />

                        <DockPanel LastChildFill="False"
                                   IsEnabled="{Binding IsChecked, ElementName=DesktopRoamingCheckBox}">
                            <TextBlock Text="走动间隔" />
                            <TextBlock x:Name="RoamIntervalValueText"
                                       DockPanel.Dock="Right"
                                       Foreground="#666666" />
                        </DockPanel>
                        <Slider x:Name="RoamIntervalSlider"
                                Minimum="20"
                                Maximum="180"
                                TickFrequency="5"
                                IsSnapToTickEnabled="True"
                                IsEnabled="{Binding IsChecked, ElementName=DesktopRoamingCheckBox}" />

                        <DockPanel LastChildFill="False"
                                   IsEnabled="{Binding IsChecked, ElementName=DesktopRoamingCheckBox}">
                            <TextBlock Text="走动速度" />
                            <TextBlock x:Name="RoamSpeedValueText"
                                       DockPanel.Dock="Right"
                                       Foreground="#666666" />
                        </DockPanel>
                        <Slider x:Name="RoamSpeedSlider"
                                Minimum="20"
                                Maximum="160"
                                TickFrequency="10"
                                IsSnapToTickEnabled="True"
                                IsEnabled="{Binding IsChecked, ElementName=DesktopRoamingCheckBox}" />

                        <Separator Margin="0,8" />
                        <CheckBox x:Name="ClickInteractionCheckBox" Content="点击互动" />
                        <CheckBox x:Name="PauseNearMouseCheckBox" Content="鼠标靠近时停步" />
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="停步距离" />
                            <TextBlock x:Name="MouseRadiusText" DockPanel.Dock="Right" Foreground="#666666" />
                        </DockPanel>
                        <Slider x:Name="MouseRadiusSlider" Minimum="20" Maximum="200" TickFrequency="10"
                                IsSnapToTickEnabled="True" IsEnabled="{Binding IsChecked, ElementName=PauseNearMouseCheckBox}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="CompanionTab" Header="陪伴">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="专注时长" FontWeight="SemiBold" />
                            <TextBlock x:Name="FocusMinutesText" DockPanel.Dock="Right" Foreground="#666666" />
                        </DockPanel>
                        <Slider x:Name="FocusMinutesSlider" Minimum="1" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True" />
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="休息时长" />
                            <TextBlock x:Name="BreakMinutesText" DockPanel.Dock="Right" Foreground="#666666" />
                        </DockPanel>
                        <Slider x:Name="BreakMinutesSlider" Minimum="1" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" />
                        <CheckBox x:Name="PauseDuringFocusCheckBox" Content="专注时暂停自动动作" />
                        <Separator Margin="0,8" />
                        <CheckBox x:Name="BreakRemindersCheckBox" Content="定时休息提醒" />
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="提醒间隔" />
                            <TextBlock x:Name="BreakReminderText" DockPanel.Dock="Right" Foreground="#666666" />
                        </DockPanel>
                        <Slider x:Name="BreakReminderSlider" Minimum="15" Maximum="180" TickFrequency="5"
                                IsSnapToTickEnabled="True" IsEnabled="{Binding IsChecked, ElementName=BreakRemindersCheckBox}" />
                        <CheckBox x:Name="NotificationsCheckBox" Content="桌面通知与完成动作" />
                        <Separator Margin="0,8" />
                        <CheckBox x:Name="DoNotDisturbCheckBox" Content="勿扰模式" />
                        <CheckBox x:Name="QuietHoursCheckBox" Content="定时勿扰" />
                        <Grid IsEnabled="{Binding IsChecked, ElementName=QuietHoursCheckBox}" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="开始" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="QuietStartInput" Grid.Column="1" MaxLength="5" MinHeight="28" Padding="6,3"
                                     AutomationProperties.Name="勿扰开始时间" />
                            <TextBlock Grid.Column="2" Text="结束" VerticalAlignment="Center" Margin="16,0,8,0" />
                            <TextBox x:Name="QuietEndInput" Grid.Column="3" MaxLength="5" MinHeight="28" Padding="6,3"
                                     AutomationProperties.Name="勿扰结束时间" />
                        </Grid>
                        <TextBlock x:Name="CompanionErrorText" Foreground="#A51F36" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="关于">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24" HorizontalAlignment="Center">
                    <Image x:Name="AboutPetImage" Width="80"
                           Height="88"
                           Margin="0,10,0,12"
                           Stretch="Uniform"
                           />
                    <TextBlock x:Name="AboutPetName" TextWrapping="Wrap" MaxWidth="380"
                               FontSize="20"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="VersionText"
                               Margin="0,6,0,18"
                               Foreground="#666666"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="AboutPetDescription" TextWrapping="Wrap" MaxWidth="380"
                               HorizontalAlignment="Center" />
                    <StackPanel Margin="0,24,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="项目主页" Click="OpenRepository_Click" />
                        <Button Content="日志目录" Click="OpenLogs_Click" />
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1"
                BorderBrush="#D4D4D4"
                BorderThickness="0,1,0,0"
                Background="#F0F0F0"
                Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" IsCancel="True" />
                <Button x:Name="SaveButton" Content="保存"
                        IsDefault="True"
                        Foreground="White"
                        Background="{StaticResource AccentBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        Click="Save_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
