<ui:ThemedWindow x:Class="YeShunguangPet.FocusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:YeShunguangPet"
        Title="专注计时" Width="400" Height="560" MinWidth="320" MinHeight="460"
        FontFamily="{DynamicResource AppFont}" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}">
    <ui:ThemedWindow.Resources>
        <Style x:Key="FocusError" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/><Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/><Setter Property="Margin" Value="0,4,0,0"/>
            <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="FocusPinButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                <Border x:Name="PinSurface" CornerRadius="5" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="PinSurface" Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PinSurface" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PinSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </ui:ThemedWindow.Resources>
    <ScrollViewer x:Name="FocusScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="{DynamicResource SurfaceBrush}" PreviewMouseLeftButtonDown="Surface_MouseDown"
                  SizeChanged="Surface_SizeChanged">
      <Grid>
        <Grid x:Name="ContentRoot" Margin="24,16" MaxWidth="480" VerticalAlignment="Center" HorizontalAlignment="Center" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid x:Name="HeaderRow" Height="36">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Image x:Name="PetImage" Width="28" Height="32" Stretch="Uniform"/>
                <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                    <TextBlock x:Name="SessionsText" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock x:Name="QuietStatus" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
                <Button x:Name="MiniModeButton" Grid.Column="2" Style="{StaticResource IconButton}" Width="30" Height="30" Margin="8,0,0,0" ToolTip="迷你模式" AutomationProperties.Name="迷你模式" Click="MiniMode_Click">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8A8;"/>
                </Button>
            </Grid>
            <Border Grid.Row="1" Background="{DynamicResource SubtleBrush}" CornerRadius="7" Padding="3" HorizontalAlignment="Center" Margin="0,4,0,0">
                <UniformGrid Columns="2" Width="184">
                    <RadioButton x:Name="FocusMode" Content="专注" GroupName="Phase" Style="{StaticResource SegmentButton}" Click="Mode_Click" Tag="Focus"/>
                    <RadioButton x:Name="BreakMode" Content="休息" GroupName="Phase" Style="{StaticResource SegmentButton}" Click="Mode_Click" Tag="Break"/>
                </UniformGrid>
            </Border>
            <Grid x:Name="DialArea" Grid.Row="2" MinHeight="196" SizeChanged="DialArea_SizeChanged">
              <Grid x:Name="DialFrame" Width="240" Height="240" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:DurationDial x:Name="Dial" Minimum="1" Maximum="120"
                                 Foreground="{DynamicResource AccentTextBrush}" Cursor="Hand"
                                 AutomationProperties.Name="计时分钟数" ToolTip="调整分钟数"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="PhaseText" FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <Grid x:Name="NumberArea" Height="78" Width="180">
                        <TextBox x:Name="MinutesInput" FontSize="58" FontWeight="Normal" FontFamily="Segoe UI"
                                 TextAlignment="Center" VerticalContentAlignment="Center" Padding="0" BorderThickness="0" Background="Transparent"
                                 MaxLength="3" ToolTip="输入分钟数" AutomationProperties.Name="分钟数"
                                 GotKeyboardFocus="Minutes_GotFocus" LostKeyboardFocus="Minutes_LostFocus" PreviewKeyDown="Minutes_KeyDown"/>
                        <TextBlock x:Name="TimeText" Text="25:00" FontSize="48" FontWeight="Normal" FontFamily="Segoe UI" Typography.NumeralAlignment="Tabular"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden"/>
                    </Grid>
                    <TextBlock x:Name="MinuteUnit" Text="分钟" FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
              </Grid>
            </Grid>
            <Border x:Name="PresetHost" Grid.Row="3" Height="36" ClipToBounds="True">
            <UniformGrid x:Name="Presets" Columns="4" MaxWidth="288" Height="32" VerticalAlignment="Top">
                <RadioButton x:Name="Preset1" GroupName="Preset" Style="{StaticResource SegmentButton}" Click="Preset_Click" Padding="4,5"/>
                <RadioButton x:Name="Preset2" GroupName="Preset" Style="{StaticResource SegmentButton}" Click="Preset_Click" Padding="4,5"/>
                <RadioButton x:Name="Preset3" GroupName="Preset" Style="{StaticResource SegmentButton}" Click="Preset_Click" Padding="4,5"/>
                <RadioButton x:Name="Preset4" GroupName="Preset" Style="{StaticResource SegmentButton}" Click="Preset_Click" Padding="4,5"/>
            </UniformGrid>
            </Border>
            <TextBlock x:Name="DurationError" Grid.Row="4" Style="{StaticResource FocusError}" AutomationProperties.LiveSetting="Polite"/>
            <StackPanel x:Name="ActionsRow" Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,4">
                <Button x:Name="ToggleButton" Style="{StaticResource PrimaryButton}" Width="156" Height="40" Click="Toggle_Click">
                    <StackPanel Orientation="Horizontal"><TextBlock x:Name="ToggleIcon" FontFamily="{StaticResource IconFont}" Text="&#xE768;" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock x:Name="ToggleText" Text="开始专注"/></StackPanel>
                </Button>
                <Button x:Name="ResetButton" Style="{StaticResource IconButton}" Width="40" Height="40" Margin="8,0,0,0" ToolTip="结束并重置计时" AutomationProperties.Name="结束并重置计时" Click="Reset_Click"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE777;"/></Button>
                <Button x:Name="SkipButton" Style="{StaticResource IconButton}" Width="40" Height="40" Margin="4,0,0,0" ToolTip="跳过休息" AutomationProperties.Name="跳过休息" Click="Skip_Click"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE893;"/></Button>
            </StackPanel>
            <Border x:Name="Footer" Grid.Row="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,6,0,0">
                <StackPanel>
                    <TextBlock x:Name="DurationText" FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <Button x:Name="HistoryButton" Style="{StaticResource LinkButton}" MinHeight="28" HorizontalAlignment="Center" Margin="0,3,0,0" Click="History_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE81C;" Margin="0,0,7,0"/><TextBlock x:Name="TodaySummary" Text="专注记录"/></StackPanel></Button>
                    <TextBlock x:Name="WindowError" Style="{StaticResource FocusError}" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Border>
        </Grid>
        <Border x:Name="MiniRoot" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/><RowDefinition Height="3"/></Grid.RowDefinitions>
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ToggleButton x:Name="MiniPinButton" Style="{StaticResource FocusPinButton}" ToolTip="置顶迷你计时器" AutomationProperties.Name="置顶迷你计时器" Click="MiniPin_Click"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE718;"/></ToggleButton>
                        <Button x:Name="ExpandButton" Style="{StaticResource IconButton}" Width="28" Height="28" MinHeight="28" ToolTip="展开计时面板" AutomationProperties.Name="展开计时面板" Click="MiniMode_Click"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8A7;"/></Button>
                        <Button x:Name="MiniCloseButton" Style="{StaticResource IconButton}" Width="28" Height="28" MinHeight="28" ToolTip="关闭面板，继续计时" AutomationProperties.Name="关闭计时面板" Click="MiniClose_Click"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE711;"/></Button>
                    </StackPanel>
                    <Grid Margin="0,0,8,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="MiniTitleText" Text="专注" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Image x:Name="MiniPetImage" Grid.Column="1" Width="20" Height="24" Margin="6,0,8,0" Stretch="Uniform" Source="{Binding Source, ElementName=PetImage}"
                               ToolTip="{Binding ToolTip, ElementName=PetImage}" AutomationProperties.Name="{Binding ToolTip, ElementName=PetImage}"/>
                        <TextBlock x:Name="MiniPhaseText" Grid.Column="2" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
                    </Grid>
                </DockPanel>
                <Grid Grid.Row="1" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="MiniTimeText" Text="{Binding Text, ElementName=TimeText}" FontSize="34" FontWeight="Normal" FontFamily="Segoe UI" Typography.NumeralAlignment="Tabular"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="MiniResetButton" Style="{StaticResource IconButton}" Width="28" Height="32" IsEnabled="{Binding IsEnabled, ElementName=ResetButton}" ToolTip="结束并重置计时" AutomationProperties.Name="结束并重置计时" Click="Reset_Click"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE777;"/></Button>
                        <Button x:Name="MiniToggleButton" Style="{StaticResource PrimaryButton}" Width="38" Height="38" Padding="0" Margin="6,0,0,0" ToolTip="{Binding Text, ElementName=ToggleText}" AutomationProperties.Name="{Binding Text, ElementName=ToggleText}" Click="Toggle_Click"><TextBlock FontFamily="{StaticResource IconFont}" Text="{Binding Text, ElementName=ToggleIcon}"/></Button>
                    </StackPanel>
                </Grid>
                <ProgressBar x:Name="MiniProgress" Grid.Row="2" Height="3" Minimum="0" Maximum="1" AutomationProperties.Name="计时剩余进度"/>
            </Grid>
        </Border>
      </Grid>
    </ScrollViewer>
</ui:ThemedWindow>
