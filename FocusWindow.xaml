<Window x:Class="YeShunguangPet.FocusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="学习陪伴" Width="380" Height="410"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="#F7F7F7" Foreground="#202020" FontFamily="Segoe UI">
    <Grid Background="#F7F7F7" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel LastChildFill="False">
            <Image x:Name="PetImage" Width="44" Height="48" Stretch="Uniform" />
            <TextBlock x:Name="PetName" Margin="10,0" MaxWidth="160" TextTrimming="CharacterEllipsis"
                       FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock x:Name="QuietStatus" DockPanel.Dock="Right" Foreground="#666666" VerticalAlignment="Center" />
        </DockPanel>
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock x:Name="PhaseText" FontSize="16" HorizontalAlignment="Center" />
            <TextBlock x:Name="TimeText" Text="25:00" FontSize="48" FontFamily="Consolas"
                       HorizontalAlignment="Center" Margin="0,8,0,12" />
            <ProgressBar x:Name="Progress" Height="4" Minimum="0" Maximum="1"
                         Foreground="#A51F36" Background="#DDDDDD" BorderThickness="0" />
            <TextBlock x:Name="SessionsText" HorizontalAlignment="Center" Foreground="#666666" Margin="0,12,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12">
            <Button x:Name="ToggleButton" Width="136" Height="36" Click="Toggle_Click"
                    Background="#A51F36" Foreground="White" BorderBrush="#A51F36">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ToggleIcon" FontFamily="Segoe MDL2 Assets" Text="&#xE768;" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="ToggleText" Text="开始专注" />
                </StackPanel>
            </Button>
            <Button x:Name="ResetButton" Width="36" Height="36" Margin="8,0,0,0" ToolTip="结束计时" Click="Reset_Click">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71A;" />
            </Button>
            <Button x:Name="SkipButton" Width="36" Height="36" Margin="8,0,0,0" ToolTip="跳过休息" Click="Skip_Click">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE893;" />
            </Button>
        </StackPanel>
        <TextBlock Grid.Row="3" x:Name="DurationText" HorizontalAlignment="Center" Foreground="#666666" Margin="0,4,0,0" />
    </Grid>
</Window>
