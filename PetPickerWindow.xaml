<ui:ThemedWindow x:Class="YeShunguangPet.PetPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:YeShunguangPet"
        Title="添加角色" Width="450" Height="430" MinWidth="380" MinHeight="340"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="添加角色" Style="{StaticResource PageHeading}" Margin="0,0,0,18"/>
        <ListBox Grid.Row="1" x:Name="Choices" HorizontalContentAlignment="Stretch" SelectionChanged="Selection_Changed">
            <ListBox.ItemTemplate><DataTemplate><Grid Margin="2,3"><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Image Source="{Binding Thumbnail}" Width="48" Height="60" Stretch="Uniform"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"><TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SourceLabel}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,5,0,0"/></StackPanel>
            </Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="取消" IsCancel="True" Margin="0,0,8,0"/><Button x:Name="AcceptButton" Content="添加" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Accept_Click"/></StackPanel>
    </Grid>
</ui:ThemedWindow>
