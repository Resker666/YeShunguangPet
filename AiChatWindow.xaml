<ui:ThemedWindow x:Class="YeShunguangPet.AiChatWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:YeShunguangPet"
    Title="角色聊天" Width="700" Height="760" MinWidth="600" MinHeight="680"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24" Background="{DynamicResource SurfaceBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="AI 设置" Click="Settings_Click" VerticalAlignment="Center"/>
            <Image x:Name="Portrait" Width="48" Height="56" Stretch="Uniform" Margin="0,0,12,0"/>
            <StackPanel VerticalAlignment="Center"><TextBlock x:Name="NameText" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="聊聊今天，也让彼此更熟悉一点" FontSize="12" Margin="0,5,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel>
        </DockPanel>
        <TabControl x:Name="ChatTabs" Grid.Row="1">
            <TabItem Header="聊天">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="发送时会将已保存的人设和最近 12 轮对话交给所配置的 AI 服务。记录保存在本机，不读取屏幕。" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,12"/>
                    <Border Grid.Row="1" Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <TextBlock x:Name="EmptyText" Text="从一句问候开始吧。&#x0a;可以先到「角色人设」填写背景和说话习惯。" TextAlignment="Center" TextWrapping="Wrap" Margin="24" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <ScrollViewer x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14">
                                <ItemsControl x:Name="MessagesList">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <StackPanel Margin="0,0,0,16">
                                            <TextBlock Text="{Binding Speaker}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,0,0,5"/>
                                            <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" Background="Transparent" Padding="0" FontSize="14" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"/>
                                        </StackPanel>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <TextBox x:Name="MessageInput" Grid.Row="2" Height="82" MaxLength="2000" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Margin="0,12,0,10" AutomationProperties.Name="聊天消息" PreviewKeyDown="Input_KeyDown"/>
                    <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button x:Name="ClearButton" Content="清空记录" Click="Clear_Click"/>
                        <TextBlock Grid.Column="1" Text="Ctrl + Enter 发送" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Button x:Name="StopButton" Grid.Column="2" Content="停止" Click="Stop_Click" IsEnabled="False" Margin="0,0,8,0"/>
                        <Button x:Name="SendButton" Grid.Column="3" Content="发送" Click="Send_Click" Style="{StaticResource PrimaryButton}" MinWidth="70"/>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="角色人设">
                <Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ProfileFields" Margin="0,0,8,12">
                            <TextBlock Text="人设同时用于聊天和 AI 台词生成。同一角色皮肤共用人设与记录，不会修改皮肤文件。" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,14"/>
                            <TextBlock Text="角色背景" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="BackgroundInput" Height="90" MaxLength="2000" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" TextChanged="Profile_Changed" AutomationProperties.Name="角色背景"/>
                            <TextBlock Text="性格" FontWeight="SemiBold" Margin="0,14,0,6"/>
                            <TextBox x:Name="PersonalityInput" Height="60" MaxLength="1000" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" TextChanged="Profile_Changed" AutomationProperties.Name="角色性格"/>
                            <TextBlock Text="说话习惯" FontWeight="SemiBold" Margin="0,14,0,6"/>
                            <TextBox x:Name="StyleInput" Height="60" MaxLength="1000" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" TextChanged="Profile_Changed" AutomationProperties.Name="说话习惯"/>
                            <TextBlock Text="示例台词" FontWeight="SemiBold" Margin="0,14,0,6"/>
                            <TextBox x:Name="ExamplesInput" Height="90" MaxLength="2000" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" TextChanged="Profile_Changed" AutomationProperties.Name="人设示例台词"/>
                        </StackPanel>
                    </ScrollViewer>
                    <Button x:Name="SaveProfileButton" Grid.Row="1" Content="保存人设" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,10,0,0" Click="SaveProfile_Click"/>
                </Grid>
            </TabItem>
        </TabControl>
        <TextBlock x:Name="StatusText" Grid.Row="2" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,14,0,0" MaxHeight="56"/>
    </Grid>
</ui:ThemedWindow>
