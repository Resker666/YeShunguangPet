<ui:ThemedWindow x:Class="YeShunguangPet.AiSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:YeShunguangPet"
    Title="AI 设置" Width="660" Height="720" MinWidth="580" MinHeight="620" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ui:SmoothScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="AI 设置" Style="{StaticResource PageHeading}"/>
                <TextBlock Text="AI 只在你主动点击时请求，不会自动读取屏幕或修改角色文件。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,18"/>
                <CheckBox x:Name="EnabledCheck" Content="启用 AI 功能（用户主动触发）" Checked="Draft_Changed" Unchecked="Draft_Changed"/>
                <StackPanel IsEnabled="{Binding IsChecked, ElementName=EnabledCheck}">
                    <TextBlock Text="服务配置" FontWeight="SemiBold" Margin="0,10,0,6"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ComboBox x:Name="ProfileSelector" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Profile_Changed" AutomationProperties.Name="AI 服务配置"/>
                        <Button Grid.Column="1" Content="+" FontSize="17" Width="36" Margin="8,0,0,0" ToolTip="新增配置" AutomationProperties.Name="新增 AI 配置" Click="AddProfile_Click"/>
                        <Button x:Name="DeleteProfileButton" Grid.Column="2" Content="&#xE74D;" FontFamily="{StaticResource IconFont}" Width="36" Margin="8,0,0,0" ToolTip="删除配置" AutomationProperties.Name="删除 AI 配置" Click="DeleteProfile_Click"/>
                    </Grid>
                    <TextBlock Text="配置名称" FontWeight="SemiBold" Margin="0,14,0,6"/>
                    <TextBox x:Name="ProfileNameInput" MaxLength="40" MinHeight="34" TextChanged="Draft_Changed"/>
                    <TextBlock Text="服务类型" FontWeight="SemiBold" Margin="0,10,0,6"/>
                    <ComboBox x:Name="ProviderSelector" SelectedValuePath="Tag" SelectionChanged="Draft_Changed">
                        <ComboBoxItem Tag="Direct" Content="直连 API"/>
                        <ComboBoxItem Tag="Relay" Content="自建中转服务"/>
                        <ComboBoxItem Tag="Local" Content="本地模型服务"/>
                    </ComboBox>
                    <TextBlock Text="Endpoint" FontWeight="SemiBold" Margin="0,14,0,6"/>
                    <TextBox x:Name="EndpointInput" MinHeight="34" ToolTip="例如 https://api.openai.com/v1" TextChanged="Draft_Changed"/>
                    <TextBlock Text="模型" FontWeight="SemiBold" Margin="0,14,0,6"/>
                    <TextBox x:Name="ModelInput" MinHeight="34" ToolTip="填写服务商支持的模型名称" TextChanged="Draft_Changed"/>
                    <TextBlock Text="API Key" FontWeight="SemiBold" Margin="0,14,0,6"/>
                    <DockPanel>
                        <Button x:Name="ClearKeyButton" DockPanel.Dock="Right" Content="清除" Click="ClearKey_Click"/>
                        <PasswordBox x:Name="ApiKeyInput" MinHeight="34" PasswordChanged="Draft_Changed"/>
                    </DockPanel>
                    <TextBlock x:Name="KeyStatusText" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,5,0,0"/>
                    <CheckBox x:Name="SpeechCheck" Content="允许 AI 生成角色台词" Checked="Draft_Changed" Unchecked="Draft_Changed"/>
                    <CheckBox x:Name="SummaryCheck" Content="允许 AI 生成专注总结" Margin="0,8,0,0" Checked="Draft_Changed" Unchecked="Draft_Changed"/>
                    <CheckBox x:Name="CaptureCheck" Content="允许 AI 处理手动确认的 OCR 文字" Margin="0,8,0,0" Checked="Draft_Changed" Unchecked="Draft_Changed"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,18,0,0"/>
            </StackPanel>
        </ui:SmoothScrollViewer>
        <DockPanel Grid.Row="1" Margin="0,16,0,0" LastChildFill="False">
            <Button x:Name="TestButton" DockPanel.Dock="Left" Content="测试连接" Click="Test_Click"/>
            <Button DockPanel.Dock="Right" Content="取消" IsCancel="True" Margin="0,0,8,0"/>
            <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="保存" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
        </DockPanel>
    </Grid>
</ui:ThemedWindow>
