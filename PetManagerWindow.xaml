<ui:ThemedWindow x:Class="YeShunguangPet.PetManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:YeShunguangPet"
    Title="桌面宠物 · 控制中心" Width="1000" Height="740" MinWidth="780" MinHeight="590"
    WindowStartupLocation="CenterScreen">
    <ui:ThemedWindow.Resources>
        <Style x:Key="Card" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,12,0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Frame" Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12"><ContentPresenter/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeading}"/>
    </ui:ThemedWindow.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="164"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="14,28,14,18">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="10,0,0,26"><TextBlock Text="桌面宠物" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="控制中心" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,5,0,0"/></StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Button x:Name="FocusNav" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="Focus_Click" Margin="0,0,0,4"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7BE;" Margin="0,0,10,0"/><TextBlock Text="专注计时"/></StackPanel></Button>
                    <Button HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="RecallAll_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE80F;" Margin="0,0,10,0"/><TextBlock Text="召回全部"/></StackPanel></Button>
                    <Separator/>
                    <CheckBox x:Name="QuietCheck" Content="勿扰" Margin="8,0" Checked="Quiet_Changed" Unchecked="Quiet_Changed"/>
                </StackPanel>
                <StackPanel>
                    <RadioButton x:Name="RolesNav" GroupName="Navigation" Style="{StaticResource NavigationButton}" Checked="Navigate_Changed" Margin="0,0,0,6"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8A9;" Margin="0,0,10,0"/><TextBlock Text="桌面角色"/></StackPanel></RadioButton>
                    <RadioButton x:Name="SettingsNav" GroupName="Navigation" Style="{StaticResource NavigationButton}" Checked="Navigate_Changed"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE713;" Margin="0,0,10,0"/><TextBlock Text="设置"/></StackPanel></RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="28,28,24,14">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ui:SmoothScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="0,0,6,0">
                    <StackPanel x:Name="RolesPage">
                        <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="桌面角色" Style="{StaticResource PageHeading}"/><TextBlock x:Name="CountText" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,7,0,0"/></StackPanel>
                            <Button x:Name="AddButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Click="Add_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0"/><TextBlock Text="添加角色"/></StackPanel></Button>
                        </Grid>
                        <Grid>
                            <ListBox x:Name="Instances" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,-12,0" ItemContainerStyle="{StaticResource Card}" SelectionChanged="Instance_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                <ListBox.ItemTemplate><DataTemplate>
                                    <Grid Height="257"><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="38"/></Grid.RowDefinitions>
                                        <DockPanel><TextBlock Text="{Binding NumberLabel}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/><TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
                                        <Image Grid.Row="1" Source="{Binding Preview}" MaxWidth="142" MaxHeight="154" Stretch="Uniform" Margin="0,3,0,6" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Grid.Row="2" Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="15" FontWeight="SemiBold" TextAlignment="Center"/>
                                        <TextBlock Grid.Row="3" Text="{Binding Scale}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,5,0,5"/>
                                        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource IconButton}" Content="&#xE890;" ToolTip="{Binding VisibilityAction}" AutomationProperties.Name="{Binding VisibilityAction}" Click="Hide_Click"/>
                                            <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="角色设置" AutomationProperties.Name="角色设置" Click="Settings_Click"/>
                                            <Button Style="{StaticResource IconButton}" Content="&#xE712;" ToolTip="更多操作" AutomationProperties.Name="更多操作" Click="More_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel x:Name="EmptyState" Height="283" Visibility="Collapsed"><TextBlock Text="暂无桌面角色" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,105,0,14"/><Button Content="添加角色" Click="Add_Click" HorizontalAlignment="Center"/></StackPanel>
                        </Grid>
                        <Separator Margin="0,26,0,22"/>
                        <ContentControl x:Name="RoleControlsHost" HorizontalContentAlignment="Stretch">
                            <StackPanel x:Name="QuickPanel">
                                <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SelectedTitle" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="皮肤与详细设置" Click="Settings_Click"/></Grid>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel><DockPanel><TextBlock Text="角色大小" FontSize="13"/><TextBlock x:Name="ScaleText" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/></DockPanel><Slider x:Name="ScaleSlider" Minimum="50" Maximum="250" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,6,0,8" ValueChanged="Display_Changed" AutomationProperties.Name="角色大小"/><CheckBox x:Name="EdgeCheck" Content="贴边收纳" Checked="Display_Changed" Unchecked="Display_Changed"/></StackPanel>
                                    <StackPanel Grid.Column="2"><CheckBox x:Name="TopmostCheck" Content="总在最前" Margin="0,0,0,12" Checked="Display_Changed" Unchecked="Display_Changed"/><CheckBox x:Name="ThroughCheck" Content="点击穿透" Checked="Display_Changed" Unchecked="Display_Changed"/></StackPanel>
                                </Grid>
                            </StackPanel>
                        </ContentControl>
                    </StackPanel>
                    <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
                        <TextBlock Text="设置" Style="{StaticResource PageHeading}" Margin="0,0,0,24"/>
                        <Border Background="{DynamicResource SidebarBrush}" CornerRadius="6" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,28"><StackPanel Orientation="Horizontal"><RadioButton x:Name="AppScope" Content="应用" GroupName="Scope" Style="{StaticResource SegmentButton}" Checked="Scope_Changed"/><RadioButton x:Name="RoleScope" Content="当前角色" GroupName="Scope" Style="{StaticResource SegmentButton}" Checked="Scope_Changed"/></StackPanel></Border>
                        <StackPanel x:Name="AppSettingsPanel">
                            <TextBlock Text="外观" Style="{StaticResource SectionTitle}"/>
                            <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="主题" FontSize="13" VerticalAlignment="Center"/><Border Grid.Column="1" Background="{DynamicResource SidebarBrush}" CornerRadius="6" Padding="3"><StackPanel Orientation="Horizontal"><RadioButton x:Name="SystemTheme" Content="跟随系统" Tag="system" GroupName="Theme" Style="{StaticResource SegmentButton}" Checked="Theme_Changed"/><RadioButton x:Name="LightTheme" Content="浅色" Tag="light" GroupName="Theme" Style="{StaticResource SegmentButton}" Checked="Theme_Changed"/><RadioButton x:Name="DarkTheme" Content="深色" Tag="dark" GroupName="Theme" Style="{StaticResource SegmentButton}" Checked="Theme_Changed"/></StackPanel></Border></Grid>
                            <DockPanel Margin="0,0,0,18"><TextBlock Text="强调色" FontSize="13" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><RadioButton x:Name="RedAccent" Background="#A92C46" Tag="#A92C46" ToolTip="绯红" AutomationProperties.Name="绯红" GroupName="Accent" Style="{StaticResource AccentSwatch}" Checked="Accent_Changed" Margin="0,0,8,0"/><RadioButton x:Name="GreenAccent" Background="#24796E" Tag="#24796E" ToolTip="青绿" AutomationProperties.Name="青绿" GroupName="Accent" Style="{StaticResource AccentSwatch}" Checked="Accent_Changed" Margin="0,0,8,0"/><RadioButton x:Name="BlueAccent" Background="#396BB8" Tag="#396BB8" ToolTip="蔚蓝" AutomationProperties.Name="蔚蓝" GroupName="Accent" Style="{StaticResource AccentSwatch}" Checked="Accent_Changed" Margin="0,0,8,0"/><RadioButton x:Name="GrayAccent" Background="#667085" Tag="#667085" ToolTip="石墨" AutomationProperties.Name="石墨" GroupName="Accent" Style="{StaticResource AccentSwatch}" Checked="Accent_Changed"/></StackPanel></DockPanel>
                            <CheckBox x:Name="MotionCheck" Content="减少动态效果" Checked="Motion_Changed" Unchecked="Motion_Changed"/>
                            <Separator Margin="0,24,0,22"/>
                            <TextBlock Text="常规" Style="{StaticResource SectionTitle}"/>
                            <CheckBox x:Name="StartupCheck" Content="开机启动" Margin="0,0,0,12" Checked="Startup_Changed" Unchecked="Startup_Changed"/>
                            <CheckBox x:Name="NotificationsCheck" Content="桌面通知与完成动作" Checked="Notifications_Changed" Unchecked="Notifications_Changed"/>
                            <Separator Margin="0,24,0,18"/>
                            <Button x:Name="FocusSettingsLink" Style="{StaticResource LinkButton}" Content="专注与休息设置" HorizontalAlignment="Left" Click="CompanionSettings_Click"/>
                            <Button x:Name="FocusHistoryLink" Style="{StaticResource LinkButton}" Content="专注记录" HorizontalAlignment="Left" Click="History_Click"/>
                            <Button x:Name="ShortcutsButton" Style="{StaticResource LinkButton}" Content="快捷键" HorizontalAlignment="Left" Click="Shortcuts_Click"/>
                            <Button Style="{StaticResource LinkButton}" Content="角色台词" HorizontalAlignment="Left" Click="Speech_Click"/>
                            <Button x:Name="DiagnosticsButton" Style="{StaticResource LinkButton}" Content="诊断与日志" HorizontalAlignment="Left" Click="Diagnostics_Click"/>
                        </StackPanel>
                        <StackPanel x:Name="RoleSettingsPanel" Visibility="Collapsed"><ComboBox x:Name="RoleChoice" DisplayMemberPath="DisplayName" SelectionChanged="RoleChoice_Changed" Margin="0,0,0,24" AutomationProperties.Name="当前角色"/><ContentControl x:Name="SettingsRoleHost" HorizontalContentAlignment="Stretch"/><TextBlock x:Name="NoRoleText" Text="暂无桌面角色" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel>
                    </StackPanel>
                </Grid>
            </ui:SmoothScrollViewer>
            <TextBlock Grid.Row="1" x:Name="StatusText" FontSize="11" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" MaxHeight="44" Margin="0,12,0,0"/>
        </Grid>
    </Grid>
</ui:ThemedWindow>
